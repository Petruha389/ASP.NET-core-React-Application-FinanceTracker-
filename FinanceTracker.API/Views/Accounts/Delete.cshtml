@model FinanceTracker.Application.DTOs.Account.AccountResponseDto
@{
    ViewData["Title"] = "Удалить счёт";
}

<h1>Удалить счёт</h1>
<h3>Вы уверены, что хотите удалить этот счёт?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Тип</dt>
        <dd class="col-sm-10">@Model.Type</dd>
        <dt class="col-sm-2">Баланс</dt>
        <dd class="col-sm-10">@Model.Balance.ToString("F2") ₽</dd>
    </dl>
    <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Удалить</button>
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>