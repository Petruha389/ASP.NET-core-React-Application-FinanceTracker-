@model IEnumerable<FinanceTracker.Application.DTOs.Account.AccountResponseDto>
@{
    ViewData["Title"] = "Счета";
}

<h1>Счета</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Создать счёт</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Название</th>
            <th>Тип</th>
            <th>Баланс</th>
            <th>Дата создания</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Type</td>
                <td>@item.Balance.ToString("F2") ₽</td>
                <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Детали</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Изменить</a>
                    <a asp-action="Deposit" asp-route-id="@item.Id" class="btn btn-sm btn-success">Пополнить</a>
                    <a asp-action="Withdraw" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Снять</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>